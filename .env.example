# Copy to .env and set GEMINI_API_KEY. Everything else has a working default.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Only used when EMBEDDING_BACKEND=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Google no longer publishes free-tier limits, so these are a conservative
# guess; the limiter tightens itself from actual 429 responses.
GEMINI_MAX_RPM=10
GEMINI_MAX_RPD=250
GEMINI_MAX_RETRIES=5
GEMINI_BACKOFF_BASE_SECONDS=2.0

# Ports are offset from the defaults so they don't clash with a local
# Postgres/Redis install. Host is 127.0.0.1 and not localhost: on Windows
# localhost resolves to ::1 first and Docker publishes IPv4 only, so every
# connection stalls on an IPv6 timeout first.
DATABASE_URL=postgresql+psycopg://aicore:aicore@127.0.0.1:5433/aicore
REDIS_URL=redis://:aicore_dev@127.0.0.1:6380/0

# local = sentence-transformers, offline and free. gemini = API, quota-bound.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the backend and the migrated column width. bge-small=384.
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_HOME=./data/models

# bge-small's window is 512 including special tokens, so 480 leaves headroom
# instead of silently truncating the tail of every chunk.
CHUNK_SIZE_TOKENS=480
CHUNK_OVERLAP_TOKENS=64

# Layer 2 is OFF: the Phase 3 sweep found hard negatives score HIGHER than
# true paraphrases with this embedder, so no safe threshold exists.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.95
CACHE_TTL_SECONDS=86400

# local | laya
CLASSIFIER_BACKEND=local
MAX_INPUT_CHARS=4000

MAX_AGENT_STEPS=8
MAX_AGENT_TOKENS=32000

# Langfuse only runs under: docker compose --profile observability up -d
# Left blank, tracing falls back to a local file sink instead of failing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
TRACING_ENABLED=true

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
